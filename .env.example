# InjectRAG demo configuration. Copy to .env and fill one provider key.

# Use groq, gemini, openai, fake, or auto. Groq is the default for this demo and is
# what the committed results/ runs were produced with. Set 'fake' only to run fully
# offline (no API calls, scripted answers) -- see DEMO.md.
INJECTRAG_PROVIDER=groq

# Spotlighting strategy for the defended condition:
# - boundary: wraps retrieved text in reference markers and warns the model
# - datamarking: also interleaves a marker between retrieved-text words
INJECTRAG_SPOTLIGHTING=boundary
INJECTRAG_DATAMARK_TOKEN=^

# --- Application (run_app.py / docker compose) ---------------------------
# What a conversation STARTS on. With the demo controls enabled (below) the
# browser can change both per conversation, so the same question can be asked
# again with the defense on without restarting.

# off | boundary | datamarking
INJECTRAG_DEFENSE=off

# clean    = the 36 seeded documents only
# poisoned = those 36 plus the 5 frozen attacker tickets
# Both are indexed at boot in a single embedding pass. A case filed by a
# technician joins the clean corpus, so it is retrievable in either.
INJECTRAG_CORPUS=poisoned

# 1 = show the defense/corpus selects in the chat header (default).
# 0 = hide them and pin every request to the two settings above. Use 0 for the
#     product surface, or for a scripted evaluation run where the condition must
#     not be changeable from a browser tab.
INJECTRAG_DEMO_CONTROLS=1

# Where the evidence trail is written: queries.jsonl / ingestions.jsonl for
# machines, and queries.log / ingestions.log -- the same records rendered for
# people -- alongside them.
# Docker overrides this to /app/logs, bind-mounted to ./logs on the host.
INJECTRAG_LOG_DIR=logs

# Google AI Studio Gemini API.
# Prefer INJECTRAG_GEMINI_KEYS for round-robin across separate projects/accounts.
INJECTRAG_GEMINI_MODEL=gemini-3.8-flash
INJECTRAG_GEMINI_KEYS=
INJECTRAG_GEMINI_TIMEOUT_SECONDS=90
INJECTRAG_GEMINI_MAX_OUTPUT_TOKENS=1024
INJECTRAG_GEMINI_RETRY_FOREVER=1
INJECTRAG_GEMINI_MAX_RETRIES=20

# Legacy single-key Gemini variables still work when INJECTRAG_GEMINI_KEYS is empty.
GEMINI_API_KEY=
# Groq OpenAI-compatible API
GROQ_API_KEY=
INJECTRAG_GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Shared OpenAI-compatible retry/rate-limit settings for Groq/OpenAI
# Decoding is greedy by default so a demo and its numbers reproduce. Groq takes
# temperature and top_p but not seed, so 0 is as pinned as the provider gets.
INJECTRAG_OPENAI_TEMPERATURE=0
INJECTRAG_GEMINI_TEMPERATURE=0

INJECTRAG_OPENAI_MIN_CALL_GAP_SECONDS=30
INJECTRAG_OPENAI_TIMEOUT_SECONDS=90
INJECTRAG_OPENAI_MAX_OUTPUT_TOKENS=1024
INJECTRAG_OPENAI_RETRY_FOREVER=1
INJECTRAG_OPENAI_MAX_RETRIES=20

# Official OpenAI API, if used instead of Groq
OPENAI_API_KEY=
INJECTRAG_OPENAI_MODEL=gpt-oss-20b
# OPENAI_BASE_URL=
